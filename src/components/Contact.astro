---
import type { Locale } from "@utils/types";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale === "en" ? en : cz;

const titleWords = t.contact.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");
---

<section id="contact" aria-labelledby="contact-title">
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="contact-title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        {restTitle && <span class="text-gradient text-glow">{restTitle}</span>}
      </h2>
      <p
        class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto animate-on-scroll-delayed"
      >
        {t.contact.subtitle}
      </p>
    </div>

    <!-- Contact Card -->
    <div class="max-w-2xl mx-auto">
      <div class="glass rounded-2xl p-8 md:p-10 animate-scale-up">
        <div
          class="flex flex-col md:flex-row gap-8 items-center md:items-start"
        >
          <!-- Photo -->
          <div class="flex-shrink-0">
            <img
              src="/images/contact/eliska-drabkova.avif"
              alt={locale === "en"
                ? "Eliška Drábková, Conference Manager"
                : "Eliška Drábková, Konferenční manažer"}
              class="w-32 h-32 md:w-40 md:h-40 rounded-2xl border-2 border-(--color-border) object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Info -->
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-2xl font-bold text-(--color-text) mb-2">
              Eliška Drábková
            </h3>
            <p
              class="text-sm font-mono text-primary uppercase tracking-wider mb-4"
            >
              {t.contact.role}
            </p>
            <p class="text-(--color-text-secondary) mb-6 leading-relaxed">
              {t.contact.description}
            </p>

            <!-- Email -->
            <a
              href="mailto:eliska.drabkova@ais-servis.cz"
              class="inline-flex items-center gap-2 px-6 py-3 bg-primary/10 hover:bg-primary/20 border border-primary/30 rounded-lg text-primary font-medium transition-all duration-300 hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>eliska.drabkova@ais-servis.cz</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
