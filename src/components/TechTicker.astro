---
const tags = [
  "AI Agentic Coding",
  "Camunda",
  "Spring Boot AI",
  "AI Guidelines",
  "Claude Code",
  "Windsurf",
  "Junie",
  "Cursor",
  "LLMs",
  "RAG",
  "Vector DB",
  "OpenAI",
  "Anthropic",
  "Automation",
  "GenAI",
  "Machine Learning",
  "React",
  "GPT Codex",
  "TypeScript",
  "Neural Networks",
];

const duplicatedTags = [...tags, ...tags]; // Duplicate for seamless infinite scroll
---

<div
  class="w-full overflow-hidden border-y border-(--color-border) py-4 relative z-10"
>
  <div class="flex animate-ticker ticker-track hover:pause w-fit">
    {
      duplicatedTags.map((tag) => (
        <div class="flex items-center mx-4 md:mx-8 shrink-0">
          <span class="ticker-item text-xl md:text-2xl font-bold text-(--color-text) hover:text-primary transition-all cursor-default whitespace-nowrap">
            {tag}
          </span>
          <span class="ml-8 md:ml-16 text-(--color-border) text-sm">•</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ticker-item {
    opacity: 0.8;
  }

  .ticker-item:hover {
    opacity: 1;
  }

  /* Spotlight effect: Dim non-hovered items when one is hovered */
  .ticker-track:has(.ticker-item:hover) .ticker-item:not(:hover) {
    opacity: 0.5;
  }

  .animate-ticker {
    animation: ticker 40s linear infinite;
  }

  .pause:hover {
    animation-play-state: paused;
  }

  @keyframes ticker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Add a gradient mask for fading edges */
  .w-full {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }
</style>
