---
import type { Locale } from "@utils/types";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

interface Props {
  locale: Locale;
  targetDate: string;
}

const { locale, targetDate } = Astro.props;
const t = locale === "en" ? en : cz;
---

<div
  id="countdown"
  class="grid grid-cols-4 gap-2 sm:gap-6"
  role="timer"
  aria-live="off"
  aria-label={t.countdown.until}
  data-target={targetDate}
>
  <div
    class="glass rounded-lg sm:rounded-xl p-2 sm:p-4 text-center animate-scale-up"
    style="animation-delay: 0ms"
  >
    <div
      id="countdown-days"
      class="text-[clamp(1.25rem,4svh,2.25rem)] font-bold text-primary"
    >
      --
    </div>
    <div
      class="text-[clamp(0.6rem,1.5svh,0.875rem)] text-(--color-text-secondary) mt-0.5 sm:mt-1"
    >
      {t.countdown.days}
    </div>
  </div>
  <div
    class="glass rounded-lg sm:rounded-xl p-2 sm:p-4 text-center animate-scale-up"
    style="animation-delay: 100ms"
  >
    <div
      id="countdown-hours"
      class="text-[clamp(1.25rem,4svh,2.25rem)] font-bold text-(--color-primary)"
    >
      --
    </div>
    <div
      class="text-[clamp(0.6rem,1.5svh,0.875rem)] text-(--color-text-secondary) mt-0.5 sm:mt-1"
    >
      {t.countdown.hours}
    </div>
  </div>
  <div
    class="glass rounded-lg sm:rounded-xl p-2 sm:p-4 text-center animate-scale-up"
    style="animation-delay: 200ms"
  >
    <div
      id="countdown-minutes"
      class="text-[clamp(1.25rem,4svh,2.25rem)] font-bold text-(--color-primary)"
    >
      --
    </div>
    <div
      class="text-[clamp(0.6rem,1.5svh,0.875rem)] text-(--color-text-secondary) mt-0.5 sm:mt-1"
    >
      {t.countdown.minutes}
    </div>
  </div>
  <div
    class="glass rounded-lg sm:rounded-xl p-2 sm:p-4 text-center animate-scale-up"
    style="animation-delay: 300ms"
  >
    <div
      id="countdown-seconds"
      class="text-[clamp(1.25rem,4svh,2.25rem)] font-bold text-(--color-primary)"
    >
      --
    </div>
    <div
      class="text-[clamp(0.6rem,1.5svh,0.875rem)] text-(--color-text-secondary) mt-0.5 sm:mt-1"
    >
      {t.countdown.seconds}
    </div>
  </div>
</div>

<script>
  import { getCountdown } from "@utils/time";

  let intervalId: ReturnType<typeof setInterval> | null = null;

  const initCountdown = () => {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }

    const countdownEl = document.getElementById("countdown");
    const targetDate = countdownEl?.dataset.target;

    const daysEl = document.getElementById("countdown-days");
    const hoursEl = document.getElementById("countdown-hours");
    const minutesEl = document.getElementById("countdown-minutes");
    const secondsEl = document.getElementById("countdown-seconds");

    const pad = (num: number): string => String(num).padStart(2, "0");

    const updateCountdown = () => {
      if (!targetDate) return;

      const countdown = getCountdown(targetDate);

      if (!countdown) {
        countdownEl?.classList.add("hidden");
        return;
      }

      if (daysEl) daysEl.textContent = pad(countdown.days);
      if (hoursEl) hoursEl.textContent = pad(countdown.hours);
      if (minutesEl) minutesEl.textContent = pad(countdown.minutes);
      if (secondsEl) secondsEl.textContent = pad(countdown.seconds);
    };

    updateCountdown();
    intervalId = setInterval(updateCountdown, 1000);
  };

  document.addEventListener("astro:page-load", initCountdown);
  initCountdown();
</script>
