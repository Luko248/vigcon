---
import type { Locale, Talk, Speaker } from '@utils/types';
import en from '@i18n/en.json';
import cz from '@i18n/cz.json';
import SpeakerInline from "./schedule/SpeakerInline.astro";

interface Props {
  talk: Talk;
  speaker?: Speaker;
  speakerImages?: Array<ImageMetadata | undefined>;
  locale: Locale;
  delay?: number;
}

const { talk, speaker, speakerImages = [], locale, delay = 0 } = Astro.props;
const t = locale === 'en' ? en : cz;

const isBreak = talk.type === 'break';
const isSpecial = talk.type === 'special';
const isNonSession = isBreak || isSpecial;
const company = talk.company || speaker?.company;
const country = talk.country || speaker?.country;
---

<article
  class:list={[
    'talk-card',
    { 'is-break': isBreak },
    { 'cursor-pointer': !isBreak },
    'animate-on-scroll'
  ]}
  style={`animation-delay: ${delay}ms`}
  role="article"
  aria-labelledby={`talk-title-${talk.id}`}
  data-talk-id={talk.id}
>
  {!isNonSession ? (
    <button
      type="button"
      class="w-full text-left"
      aria-label={`${t.schedule.viewDetails}: ${talk.title[locale]}`}
      data-modal-trigger={talk.id}
    >
      <!-- Header: Time & Language -->
      <header class="flex items-center justify-between mb-3">
        <time
          datetime={`2026-05-28T${talk.startTime}`}
          class="text-xs font-medium text-(--color-text-secondary) font-mono uppercase tracking-wider"
        >
          {talk.startTime} - {talk.endTime}
        </time>
      </header>

      <!-- Title -->
      <h3
        id={`talk-title-${talk.id}`}
        class="text-xl font-bold mb-3 text-(--color-text)"
      >
        {talk.title[locale]}
      </h3>

      <!-- Speaker Info -->
      {speaker && (
        <div class="mb-4">
          <SpeakerInline
            speaker={speaker}
            speakerImages={speakerImages}
            locale={locale}
            company={company}
            country={country}
            variant="card"
          />
        </div>
      )}

      <!-- Hashtags -->
      {talk.hashtags && talk.hashtags.length > 0 && (
        <footer class="flex flex-wrap gap-2" aria-label="Topics">
          {talk.hashtags.map((tag) => (
            <span class="hashtag text-xs">#{tag}</span>
          ))}
        </footer>
      )}
    </button>
  ) : (
    <!-- Break/Special item (no button) -->
    <div class="text-center py-4">
      <h3
        id={`talk-title-${talk.id}`}
        class={`text-lg font-semibold ${isSpecial ? 'text-primary' : 'text-(--color-text)'}`}
      >
        {talk.title[locale]}
      </h3>
    </div>
  )}
</article>
