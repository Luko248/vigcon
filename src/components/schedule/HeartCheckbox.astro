---
import type { Locale } from "@utils/types";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

interface Props {
  sessionId: string;
  locale: Locale;
  variant?: "session" | "filter";
}

const { sessionId, locale, variant = "session" } = Astro.props;
const t = locale === "en" ? en : cz;
---

<label
  class={`heart-checkbox-container ${variant === "filter" ? "filter-heart" : ""}`}
  data-session-id={sessionId}
>
  <input
    type="checkbox"
    class="heart-checkbox-input"
    data-heart-checkbox={sessionId}
  />
  <svg
    class="heart-icon"
    xmlns="http://www.w3.org/2000/svg"
    width={variant === "filter" ? "20" : "24"}
    height={variant === "filter" ? "20" : "24"}
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
  </svg>
</label>

<style>
  .heart-checkbox-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    transition: background-color 0.2s;
  }

  .filter-heart {
    width: 2rem;
    height: 2rem;
  }

  .heart-checkbox-container:hover {
    background-color: var(--color-surface);
  }

  .heart-checkbox-input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    z-index: 1;
  }

  .heart-icon {
    pointer-events: none;
    color: var(--color-text-secondary);
    opacity: 0.3;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .heart-checkbox-input:checked + .heart-icon {
    color: color-mix(in oklab, var(--color-emerald-400) 90%, transparent);
    opacity: 1;
    scale: 1.1;
  }

  .heart-checkbox-input:hover + .heart-icon {
    scale: 1.05;
  }
</style>
