---
import type { Locale, Talk, Speaker } from "@utils/types";
import SpeakerInline from "./SpeakerInline.astro";

interface Props {
  talk: Talk;
  speaker?: Speaker;
  speakerImages?: Array<ImageMetadata | undefined>;
  locale: Locale;
  viewDetailsLabel: string;
  company?: string;
  country?: string;
}

const {
  talk,
  speaker,
  speakerImages = [],
  locale,
  viewDetailsLabel,
  company,
  country
} = Astro.props;
---

<button
  type="button"
  class="timeline-talk-card h-full w-full text-left"
  data-modal-trigger={talk.id}
  data-session-tile={talk.id}
  aria-label={`${viewDetailsLabel}: ${talk.title[locale]}`}
>
  <div class="flex items-start justify-between gap-2 mb-1">
    <h4 class="text-base sm:text-lg leading-snug font-semibold text-(--color-text) line-clamp-3 flex-1">
      {talk.title[locale]}
    </h4>
    <svg
      class="heart-indicator hidden flex-shrink-0"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="currentColor"
      style="color: color-mix(in oklab, var(--color-emerald-400) 90%, transparent);"
      aria-hidden="true"
    >
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
  </div>
  <div class="text-xs font-mono uppercase tracking-wider text-(--color-text-secondary)">
    <time datetime={`2026-05-28T${talk.startTime}`}>
      {talk.startTime}
    </time>
    {" - "}
    <time datetime={`2026-05-28T${talk.endTime}`}>
      {talk.endTime}
    </time>
  </div>
  {talk.annotation && (
    <p class="text-xs text-(--color-text-secondary) mt-2 leading-relaxed line-clamp-2">
      {talk.annotation[locale]}
    </p>
  )}
  {speaker && (
    <div class="mt-3">
      <SpeakerInline
        speaker={speaker}
        speakerImages={speakerImages}
        locale={locale}
        company={company}
        country={country}
        variant="tile"
      />
    </div>
  )}
</button>

<style>
  .timeline-talk-card {
    background: var(--glass-bg);
    backdrop-filter: blur(0.75rem);
    padding: 1rem;
    border-radius: 0.75rem;
    border: 0.0625rem solid var(--glass-border);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .timeline-talk-card:hover {
    scale: 1.02;
    box-shadow: 0 0.5rem 1.5rem -0.25rem oklch(0 0 0 / 0.15);
    border-color: var(--color-primary);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
