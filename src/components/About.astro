---
import type { Locale } from "@utils/types";
import content from "@data/content.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const aboutContent = content.about[locale];

const titleWords = aboutContent.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");
---

<section id="about" class="bg-(--color-surface)" aria-labelledby="about-title">
  <div class="section-container">
    <div class="max-w-6xl mx-auto text-center">
      <!-- Section Title -->
      <h2
        id="about-title"
        class="text-3xl sm:text-4xl font-bold mb-6 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        <span class="text-gradient">{restTitle}</span>
      </h2>

      <!-- Description -->
      <p
        class="text-lg text-(--color-text-secondary) max-w-3xl mx-auto mb-16 animate-on-scroll-delayed"
      >
        {aboutContent.description}
      </p>

      <!-- Cards Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          aboutContent.cards?.map((card: any, index: number) => (
            <div
              class="glass rounded-2xl p-6 text-left hover:border-(--color-primary)/50 transition-colors animate-scale-up h-full flex flex-col"
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="w-12 h-12 rounded-xl bg-(--color-primary)/10 flex items-center justify-center text-(--color-primary) mb-4 shrink-0">
                {card.icon === "chip" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M11 9h4a2 2 0 0 0 2-2V3" />
                    <circle cx="9" cy="9" r="2" />
                    <path d="M7 21v-4a2 2 0 0 1 2-2h4" />
                    <circle cx="15" cy="15" r="2" />
                  </svg>
                )}
                {card.icon === "users" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
                {card.icon === "bulb" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-1 1.5-2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
                    <path d="M9 18h6" />
                    <path d="M10 22h4" />
                  </svg>
                )}
                {card.icon === "network" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="5" r="3" />
                    <line x1="12" x2="12" y1="8" y2="13" />
                    <line x1="12" x2="5" y1="13" y2="13" />
                    <line x1="12" x2="19" y1="13" y2="13" />
                    <circle cx="5" cy="13" r="1.5" />
                    <circle cx="19" cy="13" r="1.5" />
                    <line x1="5" x2="5" y1="14.5" y2="19" />
                    <line x1="19" x2="19" y1="14.5" y2="19" />
                    <circle cx="5" cy="19" r="1.5" />
                    <circle cx="19" cy="19" r="1.5" />
                  </svg>
                )}
              </div>
              <h3 class="text-xl font-bold mb-2">{card.title}</h3>
              <p class="text-(--color-text-secondary) text-sm leading-relaxed">
                {card.description}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Organizer -->
      <div
        class="mt-24 pt-8 border-t border-(--color-border)/30 animate-on-scroll"
      >
        <p
          class="text-sm text-(--color-text-secondary) uppercase tracking-wider mb-4"
        >
          {aboutContent.organizer?.title}
        </p>
        <div class="glass inline-flex items-center gap-4 px-6 py-3 rounded-xl">
          <div class="text-left">
            <p class="font-bold text-(--color-primary)">
              {aboutContent.organizer?.name}
            </p>
            <p class="text-xs text-(--color-text-secondary)">
              {aboutContent.organizer?.sub}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
