---
import { Image } from "astro:assets";
import type { Locale, Talk, Speaker } from '@utils/types';
import en from '@i18n/en.json';
import cz from '@i18n/cz.json';

interface Props {
  talk: Talk;
  speaker?: Speaker;
  speakerImage?: ImageMetadata;
  locale: Locale;
}

const { talk, speaker, speakerImage, locale } = Astro.props;
const t = locale === 'en' ? en : cz;
---

<dialog
  id={`dialog-${talk.id}`}
  class="backdrop:bg-black/50 backdrop:backdrop-blur-sm"
  aria-labelledby={`dialog-title-${talk.id}`}
  aria-describedby={`dialog-description-${talk.id}`}
>
  <div class="p-6 sm:p-8 max-w-2xl">
    <!-- Header -->
    <header class="flex items-start justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <time
            datetime={`2026-05-28T${talk.startTime}`}
            class="text-sm text-(--color-text-secondary)"
          >
            {talk.startTime} - {talk.endTime}
          </time>
          {talk.language && (
            <span class="px-2 py-0.5 rounded text-xs font-semibold bg-primary/10 text-primary">
              {talk.language}
            </span>
          )}
        </div>
        <h2
          id={`dialog-title-${talk.id}`}
          class="text-2xl font-bold text-(--color-text)"
        >
          {talk.title[locale]}
        </h2>
      </div>
      <button
        type="button"
        class="shrink-0 p-2 rounded-lg text-(--color-text-secondary) hover:text-(--color-text) hover:bg-(--glass-bg) transition-colors"
        aria-label={t.modal.close}
        data-close-modal
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>
    </header>

    <!-- Speaker Section -->
    {speaker && (
      <div class="flex items-start gap-4 mb-6 p-4 rounded-xl bg-(--color-bg)">
        <div class="w-20 h-20 rounded-xl bg-linear-to-br from-primary/30 to-primary/10 flex items-center justify-center overflow-hidden shrink-0">
          {speakerImage ? (
            <Image
              src={speakerImage}
              alt={`${speaker.name}${speaker.role ? `, ${speaker.role[locale]}` : ""}`}
              width={80}
              height={80}
              class="w-full h-full object-cover"
            />
          ) : (
            <>
              <img
                src={speaker.photo}
                alt={`${speaker.name}${speaker.role ? `, ${speaker.role[locale]}` : ""}`}
                width="80"
                height="80"
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <span class="hidden text-primary font-bold text-2xl items-center justify-center w-full h-full">
                {speaker.initials}
              </span>
            </>
          )}
        </div>
        <div>
          <h3 class="text-lg font-bold text-(--color-text)">{speaker.name}</h3>
          <div class="flex flex-col gap-0.5">
            {speaker.role && (
              <p class="text-primary font-medium">
                {speaker.role[locale]}
              </p>
            )}
            {speaker.country && (
              <p class="text-(--color-text-secondary)">
                {speaker.country}
              </p>
            )}
          </div>

          <!-- Social Links -->
          {speaker.social && (
            <nav class="flex items-center gap-2 mt-3" aria-label={locale === 'en' ? 'Speaker social links' : 'Sociální sítě řečníka'}>
              {speaker.social.linkedin && (
                <a
                  href={speaker.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1.5 rounded text-(--color-text-secondary) hover:text-primary transition-colors"
                  aria-label={`LinkedIn profile of ${speaker.name}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
              {speaker.social.twitter && (
                <a
                  href={`https://twitter.com/${speaker.social.twitter.replace('@', '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1.5 rounded text-(--color-text-secondary) hover:text-primary transition-colors"
                  aria-label={`Twitter profile of ${speaker.name}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
              )}
              {speaker.social.github && (
                <a
                  href={`https://github.com/${speaker.social.github}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1.5 rounded text-(--color-text-secondary) hover:text-primary transition-colors"
                  aria-label={`GitHub profile of ${speaker.name}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
              )}
            </nav>
          )}
        </div>
        <div class="mt-3">
          <p class="text-xs uppercase tracking-wider text-(--color-text-secondary) font-semibold">
            {locale === "en" ? "Company" : "Společnost"}
          </p>
          <p class="text-xs text-emerald-400/90 font-medium mt-1">
            {speaker.company}
          </p>
        </div>
      </div>
    )}

    <!-- Talk Description -->
    {talk.annotation && (
      <section aria-labelledby={`dialog-description-${talk.id}`} class="mb-6">
        <h4 class="text-sm font-semibold text-(--color-text-secondary) uppercase tracking-wider mb-2">
          {t.modal.talkAnnotation}
        </h4>
        <p id={`dialog-description-${talk.id}`} class="text-(--color-text) leading-relaxed">
          {talk.annotation[locale]}
        </p>
      </section>
    )}

    <!-- Detailed Abstract -->
    {speaker && speaker.abstract && (
      <section aria-label="Detailed abstract" class="mb-6">
        <h4 class="text-sm font-semibold text-(--color-text-secondary) uppercase tracking-wider mb-3">
          {locale === 'en' ? 'Description' : 'Popis přednášky'}
        </h4>
        <div class="prose prose-sm prose-invert max-w-none text-(--color-text-secondary) leading-relaxed whitespace-pre-wrap">
          {speaker.abstract[locale].split('\n').map((line) => {
            if (line.startsWith('## ')) {
              return <h5 class="text-(--color-text) font-bold text-base mt-4 mb-2">{line.replace('## ', '')}</h5>;
            }
            if (line.startsWith('- ')) {
              return <div class="flex gap-2 ml-2"><span class="text-primary">•</span><span>{line.replace('- ', '')}</span></div>;
            }
            if (line.trim() === '') {
              return <br />;
            }
            return <p>{line}</p>;
          })}
        </div>
      </section>
    )}

    <!-- Speaker Bio -->
    {speaker && speaker.bio && (
      <section aria-label={t.modal.speakerBio}>
        <h4 class="text-sm font-semibold text-(--color-text-secondary) uppercase tracking-wider mb-2">
          {t.modal.speakerBio}
        </h4>
        <p class="text-(--color-text-secondary) leading-relaxed">
          {speaker.bio[locale]}
        </p>
      </section>
    )}

    <!-- Hashtags -->
    {talk.hashtags && talk.hashtags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-(--color-border)">
        {talk.hashtags.map((tag) => (
          <span class="hashtag">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</dialog>
