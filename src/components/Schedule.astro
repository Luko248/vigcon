---
import type { Locale, Talk, Speaker, Track } from "@utils/types";
import SessionTile from "./schedule/SessionTile.astro";
import SessionDetail from "./schedule/SessionDetail.astro";
import SpeakerCard from "./schedule/SpeakerCard.astro";
import HeartCheckbox from "./schedule/HeartCheckbox.astro";
import scheduleData from "@data/schedule.json";
import speakersData from "@data/speakers.json";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

const speakerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/speakers/*.{jpeg,jpg,png,gif,avif,svg}",
  { eager: true }
);

const getSpeakerImage = (imagePath: string | undefined) => {
  if (!imagePath) return undefined;
  const imageName = imagePath.split("/").pop();
  const fullPath = `/src/assets/images/speakers/${imageName}`;
  return speakerImages[fullPath]?.default;
};

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = locale === "en" ? en : cz;

const { conference, isScheduled } = scheduleData;
const tracks = scheduleData.tracks as Track[];
const schedule = scheduleData.schedule as Talk[];
const speakers = speakersData.speakers as Speaker[];

const titleWords = t.schedule.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");

// Timeline configuration
const TIMELINE_START = "08:00";
const TIMELINE_END = "17:00";
const SLOT_MINUTES = 15;

const parseTime = (time: string): number => {
  const [hours, minutes] = time.split(":").map(Number);
  return hours * 60 + minutes;
};

// Calculate time slots for the timeline
const startMinutes = parseTime(TIMELINE_START);
const endMinutes = parseTime(TIMELINE_END);
const totalMinutes = endMinutes - startMinutes;
const totalSlots = Math.ceil(totalMinutes / SLOT_MINUTES);

const generateTimeLabels = (): string[] => {
  const labels: string[] = [];
  for (let i = 0; i <= totalSlots; i++) {
    const mins = startMinutes + i * SLOT_MINUTES;
    const hours = Math.floor(mins / 60);
    const minutes = mins % 60;
    labels.push(
      `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}`
    );
  }
  return labels;
};

const timeLabels = generateTimeLabels();

const getSpeaker = (speakerId?: string): Speaker | undefined => {
  if (!speakerId) return undefined;
  return speakers.find((s) => s.id === speakerId);
};

const getTalkPosition = (talk: Talk): { top: number; height: number } => {
  const talkStart = parseTime(talk.startTime);
  const talkEnd = parseTime(talk.endTime);
  const top = ((talkStart - startMinutes) / totalMinutes) * 100;
  const height = ((talkEnd - talkStart) / totalMinutes) * 100;
  return { top, height };
};

const getTrackTalks = (trackId: string): Talk[] => {
  return schedule.filter((item) => item.track === trackId);
};

// Get shared items (breaks and specials that span both tracks)
const sharedItems = schedule.filter((item) => item.track === "both");
const trackATalks = getTrackTalks("track-a");
const trackBTalks = getTrackTalks("track-b");

// Get talks with speaker details for the shared modal
const detailedTalks = schedule.filter((item) => item.speakerId);

// Calculate the pixel height for the timeline (for scrollable container)
const PIXELS_PER_SLOT = 80;
const PIXELS_PER_SLOT_MOBILE = 120;
const timelineHeight = totalSlots * PIXELS_PER_SLOT;
const timelineWidthMobile = totalSlots * PIXELS_PER_SLOT_MOBILE;
---

<section
  id="schedule"
  class="bg-(--color-surface)"
  aria-labelledby="schedule-title"
>
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="schedule-title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        {restTitle && <span class="text-gradient text-glow">{restTitle}</span>}
      </h2>
      {
        isScheduled ? (
          <p class="text-lg text-(--color-text-secondary) animate-on-scroll-delayed font-mono">
            <time datetime={conference.date}>{conference.date}</time> |
            <time datetime={`2026-05-28T${TIMELINE_START}`}>
              {TIMELINE_START}
            </time>{" "}
            -<time datetime={`2026-05-28T${TIMELINE_END}`}>{TIMELINE_END}</time>
          </p>
        ) : (
          <p class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto animate-on-scroll-delayed">
            {t.schedule.subtitle}<br />{t.schedule.subtitle2}<a href="#registration" class="text-primary hover:underline">{t.schedule.subtitleLink}</a>
          </p>
        )
      }
    </div>

    {isScheduled ? (
      <>
        <!-- Favourites Filter -->
        <div class="flex justify-center mb-6">
          <label class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg hover:bg-(--color-surface) transition-colors">
            <HeartCheckbox sessionId="filter" locale={locale} variant="filter" />
            <span class="text-sm font-medium text-(--color-text)">
              {t.schedule.showFavourites}
            </span>
          </label>
        </div>

        <!-- Desktop Timeline View -->
        <div class="hidden lg:block">
          <!-- Track Headers -->
          <div
            class="track-header-sticky grid grid-cols-[5rem_1fr_1fr] gap-4 mb-4 sticky top-(--header-height) z-40 bg-(--color-surface) py-4 transition-all duration-300"
          >
            <div class="flex items-center justify-center">
              <span
                class="text-sm font-semibold font-mono text-(--color-text-secondary) uppercase tracking-wider"
              >
                {locale === "en" ? "Time" : "Čas"}
              </span>
            </div>
            {
              tracks.map((track, index) => (
                <div
                  class="track-header-card rounded-xl p-4 text-center animate-scale-up bg-(--color-bg) border border-(--color-border) transition-all duration-300 origin-top"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <h3 class="font-bold text-(--color-text) transition-colors duration-300">
                    {track.name[locale]}
                  </h3>
                </div>
              ))
            }
          </div>

          <!-- Timeline Container -->
          <div
            class="relative overflow-x-visible"
            style={`height: ${timelineHeight}px`}
          >
            <!-- Current Time Indicator -->
            <div
              id="current-time-indicator"
              class="current-time-indicator hidden"
              style="z-index: 30;"
            >
            </div>

            <!-- Time Grid -->
            <div class="absolute inset-0 grid grid-cols-[5rem_1fr_1fr] gap-4">
              <!-- Time Labels Column -->
              <div class="relative">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 flex items-center justify-end pr-3 font-mono ${isHour ? "font-semibold text-(--color-text)" : "text-xs text-(--color-text-secondary)"}`}
                        style={`top: ${top}%; transform: translateY(-50%);`}
                      >
                        <time datetime={`2026-05-28T${time}`}>{time}</time>
                      </div>
                    );
                  })
                }
              </div>

              <!-- Track A Column -->
              <div class="relative border-l border-(--color-border)">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 border-t ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                        style={`top: ${top}%;`}
                      />
                    );
                  })
                }
                {
                  sharedItems.map((item) => {
                    const pos = getTalkPosition(item);
                    const isBreak = item.type === "break";
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <div
                          class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-primary/5 border border-dashed border-primary/20" : "glass"}`}
                        >
                          <div class="text-center px-6">
                            <p
                              class={`text-base sm:text-lg font-semibold ${isBreak ? "text-primary" : "text-(--color-text)"}`}
                            >
                              {item.title[locale]}
                            </p>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
                {
                  trackATalks.map((talk) => {
                    const pos = getTalkPosition(talk);
                    const speaker = getSpeaker(talk.speakerId);
                    const photoPaths = speaker?.photos?.length
                      ? speaker.photos
                      : speaker?.photo
                        ? [speaker.photo]
                        : [];
                    const speakerImages = photoPaths.map((path) => getSpeakerImage(path));
                    const company = talk.company || speaker?.company;
                    const country = talk.country || speaker?.country;
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <SessionTile
                          talk={talk}
                          speaker={speaker}
                          speakerImages={speakerImages}
                          locale={locale}
                          viewDetailsLabel={t.schedule.viewDetails}
                          company={company}
                          country={country}
                        />
                      </div>
                    );
                  })
                }
              </div>

              <!-- Track B Column -->
              <div class="relative border-l border-(--color-border)">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 border-t ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                        style={`top: ${top}%;`}
                      />
                    );
                  })
                }
                {
                  sharedItems.map((item) => {
                    const pos = getTalkPosition(item);
                    const isBreak = item.type === "break";
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <div
                          class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-primary/5 border border-dashed border-primary/20" : "glass"}`}
                        >
                          <div class="text-center px-6">
                            <p
                              class={`text-base sm:text-lg font-semibold ${isBreak ? "text-primary" : "text-(--color-text)"}`}
                            >
                              {item.title[locale]}
                            </p>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
                {
                  trackBTalks.map((talk) => {
                    const pos = getTalkPosition(talk);
                    const speaker = getSpeaker(talk.speakerId);
                    const photoPaths = speaker?.photos?.length
                      ? speaker.photos
                      : speaker?.photo
                        ? [speaker.photo]
                        : [];
                    const speakerImages = photoPaths.map((path) => getSpeakerImage(path));
                    const company = talk.company || speaker?.company;
                    const country = talk.country || speaker?.country;
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <SessionTile
                          talk={talk}
                          speaker={speaker}
                          speakerImages={speakerImages}
                          locale={locale}
                          viewDetailsLabel={t.schedule.viewDetails}
                          company={company}
                          country={country}
                        />
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile View (Horizontal Timeline) -->
        <div class="lg:hidden overflow-x-auto overflow-y-hidden bg-(--color-surface) scrollbar-hide touch-pan-x">
          <div class="relative" style={`width: ${timelineWidthMobile}px; min-width: 100%;`}>
            <!-- Current Time Indicator -->
            <div
              id="current-time-indicator-mobile"
              class="absolute top-0 bottom-0 w-[0.125rem] pointer-events-none hidden"
              style="z-index: 100; background: oklch(0.55 0.22 29); box-shadow: 0 0 0.5rem oklch(0.55 0.22 29 / 0.5);"
            >
              <div class="absolute top-2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 rounded-full" style="background: oklch(0.55 0.22 29); box-shadow: 0 0 0.5rem oklch(0.55 0.22 29 / 0.8);"></div>
            </div>

            <!-- Time Header -->
            <div class="sticky top-0 z-30 flex h-8 bg-(--color-surface) border-b border-(--color-border)">
              <div class="sticky left-0 z-40 flex-none w-12 bg-(--color-surface) border-r border-(--color-border)"></div>
              <div class="relative flex-1">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const left = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute top-0 bottom-0 flex items-center justify-start border-l ${isHour ? "border-(--color-border) font-semibold text-(--color-text)" : "border-(--color-border)/30 text-xs text-(--color-text-secondary)"}`}
                        style={`left: ${left}%; transform: translateX(-1px); padding-inline-start: 0.25rem;`}
                      >
                        <time datetime={`2026-05-28T${time}`}>{time}</time>
                      </div>
                    );
                  })
                }
              </div>
            </div>

            <!-- Tracks -->
            {
              tracks.map((track, trackIndex) => {
                const isTrackA = trackIndex === 0;
                const trackTalks = isTrackA ? trackATalks : trackBTalks;

                return (
                  <div class={`flex h-64 border-b border-(--color-border) ${trackIndex === tracks.length - 1 ? "border-b-0" : ""}`}>
                    {/* Track Header */}
                    <div class="sticky left-0 z-20 flex-none w-12 flex items-center justify-center bg-(--color-surface) border-r border-(--color-border)">
                      <h3
                        class="text-sm font-bold text-(--color-text) uppercase tracking-wider whitespace-nowrap"
                        style="writing-mode: vertical-rl; transform: rotate(180deg); padding-block: 1rem;"
                      >
                        {track.name[locale]}
                      </h3>
                    </div>

                    {/* Track Content */}
                    <div class="relative flex-1">
                      {/* Grid Lines */}
                      {
                        timeLabels.map((time, index) => {
                          const isHour = time.endsWith(":00");
                          const left = (index / totalSlots) * 100;
                          return (
                            <div
                              class={`absolute top-0 bottom-0 border-l ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                              style={`left: ${left}%;`}
                            />
                          );
                        })
                      }

                      {/* Shared Items */}
                      {
                        sharedItems.map((item) => {
                          const pos = getTalkPosition(item);
                          const isBreak = item.type === "break";
                          return (
                            <div
                              class="absolute top-0 bottom-0 py-2 px-1"
                              style={`left: ${pos.top}%; width: ${pos.height}%;`}
                            >
                              <div
                                class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-primary/5 border border-dashed border-primary/20" : "glass"}`}
                              >
                                <p
                                  class={`text-sm font-semibold text-center leading-tight ${isBreak ? "text-primary" : "text-(--color-text)"}`}
                                >
                                  {item.title[locale]}
                                </p>
                              </div>
                            </div>
                          );
                        })
                      }

                      {/* Talks */}
                      {
                        trackTalks.map((talk) => {
                          const pos = getTalkPosition(talk);
                          const speaker = getSpeaker(talk.speakerId);
                          const photoPaths = speaker?.photos?.length
                            ? speaker.photos
                            : speaker?.photo
                              ? [speaker.photo]
                              : [];
                          const speakerImages = photoPaths.map((path) => getSpeakerImage(path));
                          const company = talk.company || speaker?.company;
                          const country = talk.country || speaker?.country;
                          return (
                            <div
                              class="absolute top-0 bottom-0 py-2 px-1"
                              style={`left: ${pos.top}%; width: ${pos.height}%;`}
                            >
                              <SessionTile
                                talk={talk}
                                speaker={speaker}
                                speakerImages={speakerImages}
                                locale={locale}
                                viewDetailsLabel={t.schedule.viewDetails}
                                company={company}
                                country={country}
                              />
                            </div>
                          );
                        })
                      }
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </>
    ) : (
      <>
        <!-- Speakers Grid (Unscheduled View) -->
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {
            speakers.map((speaker, index) => {
              const photo1 = speaker.photos?.[0] || speaker.photo;
              const photo2 = speaker.photos?.[1];
              const img1 = getSpeakerImage(photo1);
              const img2 = getSpeakerImage(photo2);
              const talk = schedule.find((t) => t.speakerId === speaker.id);
              const company = talk?.company || speaker.company;
              const country = talk?.country || speaker.country;
              
              return (
                <SpeakerCard
                  speaker={speaker}
                  talk={talk}
                  locale={locale}
                  delay={index * 100}
                  speakerImagePrimary={img1}
                  speakerImageSecondary={img2}
                  company={company}
                  country={country}
                  viewDetailsLabel={t.schedule.viewDetails}
                />
              );
            })
          }
        </div>

        <!-- Call to Action -->
        <div class="text-center mt-12 animate-on-scroll">
          <p class="text-(--color-text-secondary) mb-4">{t.schedule.register}</p>
          <a href="#registration" class="text-primary font-semibold hover:underline inline-flex items-center gap-1">
            {t.schedule.registerLink}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </>
    )}
  </div>
</section>

<!-- Shared Session Modals -->
{
  detailedTalks.map((talk) => {
    const speaker = getSpeaker(talk.speakerId);
    const photoPaths = speaker?.photos?.length
      ? speaker.photos
      : speaker?.photo
        ? [speaker.photo]
        : [];
    const speakerImages = photoPaths.map((path) => getSpeakerImage(path));

    return (
      <SessionDetail
        talk={talk}
        speaker={speaker}
        speakerImages={speakerImages}
        locale={locale}
        isScheduled={isScheduled}
      />
    );
  })
}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const FAVOURITES_KEY = "vigcon-favourites";
  const FILTER_STATE_KEY = "vigcon-filter-active";
  const CONFERENCE_DATE = "2026-05-28";
  const TIMELINE_START = "08:00";
  const TIMELINE_END = "17:00";

  /** @returns Favourites object from localStorage */
  function getFavourites(): Record<string, boolean> {
    try {
      const stored = localStorage.getItem(FAVOURITES_KEY);
      return stored ? JSON.parse(stored) : {};
    } catch {
      return {};
    }
  }

  /** @param favourites - Favourites object to save */
  function saveFavourites(favourites: Record<string, boolean>): void {
    try {
      localStorage.setItem(FAVOURITES_KEY, JSON.stringify(favourites));
    } catch (e) {
      console.error("Failed to save favourites:", e);
    }
  }

  /** @param sessionId - Session ID to check */
  function isFavourite(sessionId: string): boolean {
    const favourites = getFavourites();
    return favourites[sessionId] === true;
  }

  /** @param sessionId - Session ID to update */
  function setFavourite(sessionId: string, value: boolean): void {
    const favourites = getFavourites();
    value ? favourites[sessionId] = true : delete favourites[sessionId];
    saveFavourites(favourites);
  }

  /** @returns Filter state from localStorage */
  function getFilterState(): boolean {
    try {
      const stored = localStorage.getItem(FILTER_STATE_KEY);
      return stored === "true";
    } catch {
      return false;
    }
  }

  /** @param active - Filter active state */
  function saveFilterState(active: boolean): void {
    try {
      localStorage.setItem(FILTER_STATE_KEY, active.toString());
    } catch (e) {
      console.error("Failed to save filter state:", e);
    }
  }

  /** @returns Localized texts object */
  function getLocalizedTexts() {
    const locale = document.documentElement.lang || "en";
    const texts = {
      en: {
        addToFavourites: "Add to favourites",
        removeFromFavourites: "Remove from favourites",
        showFavourites: "Show favourites",
        hideFavourites: "Hide favourites"
      },
      cz: {
        addToFavourites: "Přidat do oblíbených",
        removeFromFavourites: "Odebrat z oblíbených",
        showFavourites: "Zobrazit oblíbené",
        hideFavourites: "Skrýt oblíbené"
      }
    };
    return texts[locale as keyof typeof texts] || texts.en;
  }

  /** @param checkbox - Checkbox element to update title for */
  function updateCheckboxTitle(checkbox: HTMLInputElement, t: ReturnType<typeof getLocalizedTexts>): void {
    const container = checkbox.closest(".heart-checkbox-container");
    if (!container) return;

    const title = checkbox.checked ? t.removeFromFavourites : t.addToFavourites;
    container.setAttribute("title", title);
  }

  /** @param checkbox - Checkbox element */
  function handleCheckboxChange(
    checkbox: HTMLInputElement,
    sessionId: string,
    t: ReturnType<typeof getLocalizedTexts>,
    callbacks: { updateIndicators: () => void; applyFilter: () => void }
  ): void {
    setFavourite(sessionId, checkbox.checked);
    updateCheckboxTitle(checkbox, t);
    callbacks.updateIndicators();
    callbacks.applyFilter();
  }

  /** @param checkbox - Checkbox element to initialize */
  function initSessionCheckbox(
    checkbox: HTMLInputElement,
    t: ReturnType<typeof getLocalizedTexts>,
    callbacks: { updateIndicators: () => void; applyFilter: () => void }
  ): void {
    const sessionId = checkbox.getAttribute("data-heart-checkbox");
    if (!sessionId || sessionId === "filter") return;

    checkbox.checked = isFavourite(sessionId);
    updateCheckboxTitle(checkbox, t);
    checkbox.addEventListener("change", () => handleCheckboxChange(checkbox, sessionId, t, callbacks));
  }

  /** @param element - Element with session ID */
  function updateHeartIndicator(element: Element): void {
    const sessionId = element.getAttribute("data-session-tile") || element.getAttribute("data-speaker-card");
    if (!sessionId) return;

    const heartIndicator = element.querySelector(".heart-indicator");
    if (!heartIndicator) return;

    isFavourite(sessionId)
      ? heartIndicator.classList.remove("hidden")
      : heartIndicator.classList.add("hidden");
  }

  /** Updates all heart indicators on tiles and cards */
  function updateHeartIndicators(): void {
    document.querySelectorAll("[data-session-tile]").forEach(updateHeartIndicator);
    document.querySelectorAll("[data-speaker-card]").forEach(updateHeartIndicator);
  }

  /** @param element - Element to set opacity on */
  function setElementOpacity(element: Element, sessionId: string | null, isFilterActive: boolean): void {
    if (!sessionId) return;

    const opacity = isFilterActive && !isFavourite(sessionId) ? "0.25" : "1";
    (element as HTMLElement).style.opacity = opacity;
  }

  /** @param filterCheckbox - Filter checkbox element */
  function updateFilterLabel(filterCheckbox: HTMLInputElement, t: ReturnType<typeof getLocalizedTexts>): void {
    const heartContainer = filterCheckbox.closest(".heart-checkbox-container");
    const outerLabel = heartContainer?.parentElement;
    const textSpan = outerLabel?.querySelector("span.text-sm");
    if (!outerLabel || !textSpan) return;

    const labelText = filterCheckbox.checked ? t.hideFavourites : t.showFavourites;
    outerLabel.setAttribute("title", labelText);
    textSpan.textContent = labelText;
  }

  /** @param filterCheckbox - Filter checkbox element */
  function applyFavouritesFilter(filterCheckbox: HTMLInputElement): void {
    const isFilterActive = filterCheckbox.checked;

    document.querySelectorAll("[data-session-tile]").forEach(tile => {
      const sessionId = tile.getAttribute("data-session-tile");
      setElementOpacity(tile, sessionId, isFilterActive);
    });

    document.querySelectorAll("[data-speaker-card]").forEach(card => {
      const sessionId = card.getAttribute("data-speaker-card");
      setElementOpacity(card, sessionId, isFilterActive);
    });
  }

  /** @param filterCheckbox - Filter checkbox element */
  function initFilterCheckbox(
    filterCheckbox: HTMLInputElement,
    t: ReturnType<typeof getLocalizedTexts>
  ): void {
    filterCheckbox.checked = getFilterState();
    updateFilterLabel(filterCheckbox, t);

    filterCheckbox.addEventListener("change", () => {
      saveFilterState(filterCheckbox.checked);
      updateFilterLabel(filterCheckbox, t);
      applyFavouritesFilter(filterCheckbox);
    });
  }

  /** Initializes all heart checkboxes */
  function initHeartCheckboxes(
    t: ReturnType<typeof getLocalizedTexts>,
    filterCheckbox: HTMLInputElement | null
  ): void {
    const checkboxes = document.querySelectorAll("[data-heart-checkbox]") as NodeListOf<HTMLInputElement>;
    const callbacks = {
      updateIndicators: updateHeartIndicators,
      applyFilter: () => filterCheckbox && applyFavouritesFilter(filterCheckbox)
    };

    checkboxes.forEach(checkbox => initSessionCheckbox(checkbox, t, callbacks));
  }

  /** @param dialog - Dialog element to open */
  function openDialog(dialog: HTMLDialogElement, t: ReturnType<typeof getLocalizedTexts>, filterCheckbox: HTMLInputElement | null): void {
    dialog.showModal();
    document.body.style.overflow = "hidden";
    initHeartCheckboxes(t, filterCheckbox);
  }

  /** @param dialog - Dialog element to close */
  function closeDialog(dialog: HTMLDialogElement): void {
    dialog.close();
    document.body.style.overflow = "";
  }

  /** @param trigger - Modal trigger element */
  function handleModalTrigger(trigger: Element, t: ReturnType<typeof getLocalizedTexts>, filterCheckbox: HTMLInputElement | null): void {
    const talkId = trigger.getAttribute("data-modal-trigger");
    if (!talkId) return;

    const dialog = document.getElementById(`dialog-${talkId}`) as HTMLDialogElement;
    if (dialog) openDialog(dialog, t, filterCheckbox);
  }

  /** @param button - Close button element */
  function handleCloseButton(button: Element): void {
    const dialog = button.closest("dialog") as HTMLDialogElement;
    if (dialog) closeDialog(dialog);
  }

  /** @param dialog - Dialog element */
  function handleDialogBackdrop(dialog: Element, e: Event): void {
    if (e.target === dialog) closeDialog(dialog as HTMLDialogElement);
  }

  /** Initializes modal dialogs */
  function initModalDialogs(t: ReturnType<typeof getLocalizedTexts>, filterCheckbox: HTMLInputElement | null): void {
    document.querySelectorAll("[data-modal-trigger]").forEach(trigger => {
      trigger.addEventListener("click", () => handleModalTrigger(trigger, t, filterCheckbox));
    });

    document.querySelectorAll("[data-close-modal]").forEach(button => {
      button.addEventListener("click", () => handleCloseButton(button));
    });

    document.querySelectorAll("dialog").forEach(dialog => {
      dialog.addEventListener("click", e => handleDialogBackdrop(dialog, e));
      dialog.addEventListener("close", () => { document.body.style.overflow = ""; });
    });
  }

  /** @param time - Time string in HH:MM format */
  function parseTime(time: string): number {
    const [hours, minutes] = time.split(":").map(Number);
    return hours * 60 + minutes;
  }

  /** @param indicator - Indicator element */
  function hideIndicator(indicator: HTMLElement): void {
    indicator.classList.add("hidden");
  }

  /** @param indicator - Indicator element */
  function showIndicator(indicator: HTMLElement, position: number, isDesktop: boolean): void {
    indicator.classList.remove("hidden");
    indicator.style[isDesktop ? "top" : "left"] = `${position}%`;
  }

  /** @returns true if event is past */
  function isEventPast(): boolean {
    const today = new Date();
    const eventDate = new Date(`${CONFERENCE_DATE}T00:00:00`);
    const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    return todayStart.getTime() > eventDate.getTime();
  }

  /** @returns true if current time is within timeline */
  function isWithinTimeline(): boolean {
    const now = new Date();
    const currentMinutes = now.getHours() * 60 + now.getMinutes();
    const startMinutes = parseTime(TIMELINE_START);
    const endMinutes = parseTime(TIMELINE_END);
    return currentMinutes >= startMinutes && currentMinutes <= endMinutes;
  }

  /** @returns Position percentage for current time */
  function calculateTimePosition(): number {
    const now = new Date();
    const currentMinutes = now.getHours() * 60 + now.getMinutes();
    const startMinutes = parseTime(TIMELINE_START);
    const endMinutes = parseTime(TIMELINE_END);
    const totalMinutes = endMinutes - startMinutes;
    return ((currentMinutes - startMinutes) / totalMinutes) * 100;
  }

  /** Updates time indicator position */
  function updateTimeIndicator(): void {
    const indicator = document.getElementById("current-time-indicator");
    const mobileIndicator = document.getElementById("current-time-indicator-mobile");
    if (!indicator && !mobileIndicator) return;

    if (isEventPast() || !isWithinTimeline()) {
      if (indicator) hideIndicator(indicator);
      if (mobileIndicator) hideIndicator(mobileIndicator);
      return;
    }

    const position = calculateTimePosition();
    if (indicator) showIndicator(indicator, position, true);
    if (mobileIndicator) showIndicator(mobileIndicator, position, false);
  }

  /** Starts time indicator interval */
  function startTimeIndicatorInterval(): void {
    updateTimeIndicator();
    const intervalId = setInterval(updateTimeIndicator, 60000);
    document.addEventListener("astro:before-swap", () => clearInterval(intervalId), { once: true });
  }

  /** Main initialization function */
  function initSchedule(): void {
    const t = getLocalizedTexts();
    const filterCheckbox = document.querySelector("[data-heart-checkbox='filter']") as HTMLInputElement | null;

    if (filterCheckbox) {
      initFilterCheckbox(filterCheckbox, t);
    }

    initHeartCheckboxes(t, filterCheckbox);
    updateHeartIndicators();

    if (filterCheckbox) {
      applyFavouritesFilter(filterCheckbox);
    }

    initModalDialogs(t, filterCheckbox);
    startTimeIndicatorInterval();
  }

  document.addEventListener("astro:page-load", initSchedule);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSchedule);
  } else {
    initSchedule();
  }
</script>
