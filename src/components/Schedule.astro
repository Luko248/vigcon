---
import type { Locale, Talk, Speaker } from "@utils/types";
import TalkCard from "./TalkCard.astro";
import TalkModal from "./TalkModal.astro";
import scheduleData from "@data/schedule.json";
import speakersData from "@data/speakers.json";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale === "en" ? en : cz;

const { conference, tracks, isScheduled } = scheduleData;
const schedule = scheduleData.schedule as Talk[];
const speakers = speakersData.speakers as Speaker[];

const titleWords = t.schedule.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");

// Timeline configuration
const TIMELINE_START = "08:30";
const TIMELINE_END = "18:00";
const SLOT_MINUTES = 15;

const parseTime = (time: string): number => {
  const [hours, minutes] = time.split(":").map(Number);
  return hours * 60 + minutes;
};

// Calculate time slots for the timeline
const startMinutes = parseTime(TIMELINE_START);
const endMinutes = parseTime(TIMELINE_END);
const totalMinutes = endMinutes - startMinutes;
const totalSlots = Math.ceil(totalMinutes / SLOT_MINUTES);

const generateTimeLabels = (): string[] => {
  const labels: string[] = [];
  for (let i = 0; i <= totalSlots; i++) {
    const mins = startMinutes + i * SLOT_MINUTES;
    const hours = Math.floor(mins / 60);
    const minutes = mins % 60;
    labels.push(
      `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}`
    );
  }
  return labels;
};

const timeLabels = generateTimeLabels();

const getSpeaker = (speakerId?: string): Speaker | undefined => {
  if (!speakerId) return undefined;
  return speakers.find((s) => s.id === speakerId);
};

const getTalkPosition = (talk: Talk): { top: number; height: number } => {
  const talkStart = parseTime(talk.startTime);
  const talkEnd = parseTime(talk.endTime);
  const top = ((talkStart - startMinutes) / totalMinutes) * 100;
  const height = ((talkEnd - talkStart) / totalMinutes) * 100;
  return { top, height };
};

const getTrackTalks = (trackId: string): Talk[] => {
  return schedule.filter((item) => item.track === trackId);
};

// Get shared items (breaks and specials that span both tracks)
const sharedItems = schedule.filter((item) => item.track === "both");
const trackATalks = getTrackTalks("track-a");
const trackBTalks = getTrackTalks("track-b");

// Get all regular talks (non-break) for modals
const regularTalks = schedule.filter(
  (item) => !item.type || item.type === "special"
);

// Calculate the pixel height for the timeline (for scrollable container)
const PIXELS_PER_SLOT = 80;
const timelineHeight = totalSlots * PIXELS_PER_SLOT;
---

<section
  id="schedule"
  class="bg-(--color-surface)"
  aria-labelledby="schedule-title"
>
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="schedule-title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        {restTitle && <span class="text-gradient text-glow">{restTitle}</span>}
      </h2>
      {
        isScheduled ? (
          <p class="text-lg text-(--color-text-secondary) animate-on-scroll-delayed font-mono">
            <time datetime={conference.date}>{conference.date}</time> |
            <time datetime={`2026-05-29T${TIMELINE_START}`}>
              {TIMELINE_START}
            </time>{" "}
            -<time datetime={`2026-05-29T${TIMELINE_END}`}>{TIMELINE_END}</time>
          </p>
        ) : (
          <p class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto animate-on-scroll-delayed">
            {t.schedule.subtitle}
          </p>
        )
      }
    </div>

    {isScheduled ? (
      <>
        <!-- Desktop Timeline View -->
        <div class="hidden lg:block">
          <!-- Track Headers -->
          <div
            class="track-header-sticky grid grid-cols-[5rem_1fr_1fr] gap-4 mb-4 sticky top-(--header-height) z-40 bg-(--color-surface) py-4 transition-all duration-300"
          >
            <div class="flex items-center justify-center">
              <span
                class="text-sm font-semibold font-mono text-(--color-text-secondary) uppercase tracking-wider"
              >
                {locale === "en" ? "Time" : "Čas"}
              </span>
            </div>
            {
              tracks.map((track, index) => (
                <div
                  class="track-header-card rounded-xl p-4 text-center animate-scale-up bg-(--color-bg) border border-(--color-border) transition-all duration-300 origin-top"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <h3 class="font-bold text-(--color-text) transition-colors duration-300">
                    {track.name[locale]}
                  </h3>
                </div>
              ))
            }
          </div>

          <!-- Timeline Container -->
          <div
            class="relative overflow-x-visible"
            style={`height: ${timelineHeight}px`}
          >
            <!-- Current Time Indicator -->
            <div
              id="current-time-indicator"
              class="current-time-indicator hidden"
              style="z-index: 30;"
            >
            </div>

            <!-- Time Grid -->
            <div class="absolute inset-0 grid grid-cols-[5rem_1fr_1fr] gap-4">
              <!-- Time Labels Column -->
              <div class="relative">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 flex items-center justify-end pr-3 font-mono ${isHour ? "font-semibold text-(--color-text)" : "text-xs text-(--color-text-secondary)"}`}
                        style={`top: ${top}%; transform: translateY(-50%);`}
                      >
                        <time datetime={`2026-05-29T${time}`}>{time}</time>
                      </div>
                    );
                  })
                }
              </div>

              <!-- Track A Column -->
              <div class="relative border-l border-(--color-border)">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 border-t ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                        style={`top: ${top}%;`}
                      />
                    );
                  })
                }
                {
                  sharedItems.map((item) => {
                    const pos = getTalkPosition(item);
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <div
                          class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-(--color-primary)/5 border border-dashed border-(--color-primary)/20" : "glass"}`}
                        >
                          <div class="text-center px-4 font-mono text-sm">
                            <time datetime={`2026-05-29T${item.startTime}`}>
                              {item.startTime}
                            </time>{" "}
                            -
                            <time datetime={`2026-05-29T${item.endTime}`}>
                              {item.endTime}
                            </time>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
                {
                  trackATalks.map((talk) => {
                    const pos = getTalkPosition(talk);
                    const speaker = getSpeaker(talk.speakerId);
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <button
                          type="button"
                          class="timeline-talk-card h-full w-full text-left"
                          data-modal-trigger={talk.id}
                          aria-label={`${t.schedule.viewDetails}: ${talk.title[locale]}`}
                        >
                          <div class="flex items-center gap-2 mb-1 font-sans text-xs text-(--color-primary)">
                            <time datetime={`2026-05-29T${talk.startTime}`}>
                              {talk.startTime}
                            </time>
                            {talk.language && (
                              <span class="px-1.5 py-0.5 rounded text-[0.625rem] font-semibold bg-(--color-primary)/10 text-(--color-primary)">
                                {talk.language}
                              </span>
                            )}
                          </div>
                          <h4 class="text-sm font-semibold text-(--color-text) line-clamp-2 mb-1">
                            {talk.title[locale]}
                          </h4>
                          {speaker && (
                            <div class="flex items-center gap-2">
                              <div class="w-6 h-6 rounded-full bg-linear-to-br from-(--color-primary)/30 to-(--color-primary)/10 flex items-center justify-center overflow-hidden shrink-0">
                                <img
                                  src={speaker.photo}
                                  alt=""
                                  width="24"
                                  height="24"
                                  class="w-full h-full object-cover"
                                  loading="lazy"
                                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                />
                                <span class="hidden text-(--color-primary) font-bold text-[0.5rem] items-center justify-center w-full h-full">
                                  {speaker.name
                                    .split(" ")
                                    .map((n) => n[0])
                                    .join("")}
                                </span>
                              </div>
                              <span class="text-xs text-(--color-text-secondary) truncate">
                                {speaker.name}
                              </span>
                            </div>
                          )}
                        </button>
                      </div>
                    );
                  })
                }
              </div>

              <!-- Track B Column -->
              <div class="relative border-l border-(--color-border)">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 border-t ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                        style={`top: ${top}%;`}
                      />
                    );
                  })
                }
                {
                  sharedItems.map((item) => {
                    const pos = getTalkPosition(item);
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <div
                          class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-(--color-primary)/5 border border-dashed border-(--color-primary)/20" : "glass"}`}
                        >
                          <div class="text-center px-4 font-mono text-sm">
                            <time datetime={`2026-05-29T${item.startTime}`}>
                              {item.startTime}
                            </time>{" "}
                            -
                            <time datetime={`2026-05-29T${item.endTime}`}>
                              {item.endTime}
                            </time>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
                {
                  trackBTalks.map((talk) => {
                    const pos = getTalkPosition(talk);
                    const speaker = getSpeaker(talk.speakerId);
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <button
                          type="button"
                          class="timeline-talk-card h-full w-full text-left"
                          data-modal-trigger={talk.id}
                          aria-label={`${t.schedule.viewDetails}: ${talk.title[locale]}`}
                        >
                          <div class="flex items-center gap-2 mb-1 font-sans text-xs text-(--color-primary)">
                            <time datetime={`2026-05-29T${talk.startTime}`}>
                              {talk.startTime}
                            </time>
                            {talk.language && (
                              <span class="px-1.5 py-0.5 rounded text-[0.625rem] font-semibold bg-(--color-primary)/10 text-(--color-primary)">
                                {talk.language}
                              </span>
                            )}
                          </div>
                          <h4 class="text-sm font-semibold text-(--color-text) line-clamp-2 mb-1">
                            {talk.title[locale]}
                          </h4>
                          {speaker && (
                            <div class="flex items-center gap-2">
                              <div class="w-6 h-6 rounded-full bg-linear-to-br from-(--color-primary)/30 to-(--color-primary)/10 flex items-center justify-center overflow-hidden shrink-0">
                                <img
                                  src={speaker.photo}
                                  alt=""
                                  width="24"
                                  height="24"
                                  class="w-full h-full object-cover"
                                  loading="lazy"
                                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                />
                                <span class="hidden text-(--color-primary) font-bold text-[0.5rem] items-center justify-center w-full h-full">
                                  {speaker.name
                                    .split(" ")
                                    .map((n) => n[0])
                                    .join("")}
                                </span>
                              </div>
                              <span class="text-xs text-(--color-text-secondary) truncate">
                                {speaker.name}
                              </span>
                            </div>
                          )}
                        </button>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile View (Card List) -->
        <div class="lg:hidden space-y-3">
          {
            schedule.map((talk, index) => (
              <div>
                {talk.track !== "both" && (
                  <div class="text-xs font-semibold text-(--color-primary) uppercase tracking-wider mb-2">
                    {talk.track === "track-a"
                      ? tracks[0].name[locale]
                      : tracks[1].name[locale]}
                  </div>
                )}
                <TalkCard
                  talk={talk}
                  speaker={getSpeaker(talk.speakerId)}
                  locale={locale}
                  delay={index * 30}
                />
              </div>
            ))
          }
        </div>
      </>
    ) : (
      <>
        <!-- Speakers Grid (Unscheduled View) -->
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {
            speakers.map((speaker, index) => {
              const speakerNames = speaker.name.split(" & ");
              const hasTwoSpeakers = speakerNames.length === 2;
              
              return (
                <button
                  type="button"
                  class="speaker-card glass rounded-2xl p-6 hover:border-(--color-primary)/50 transition-colors animate-scale-up group h-full flex flex-col text-left cursor-pointer"
                  style={`animation-delay: ${index * 100}ms`}
                  data-modal-trigger={`speaker-${speaker.id}`}
                  aria-label={`${t.schedule.viewDetails}: ${speaker.topic[locale]}`}
                >
                  <!-- Session Title -->
                  <h3 class="font-bold text-lg leading-tight mb-3 group-hover:text-(--color-primary) transition-colors">
                    {speaker.topic[locale]}
                  </h3>

                  <!-- Hashtags -->
                  {speaker.hashtags && speaker.hashtags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {speaker.hashtags.map((tag: string) => (
                        <span class="px-2 py-0.5 rounded-md bg-(--color-primary)/10 text-(--color-primary) text-[10px] font-medium font-mono">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <!-- Short Description -->
                  <div class="mb-4 grow">
                    <p class="text-sm text-(--color-text-secondary) leading-relaxed line-clamp-3">
                      {speaker.shortDesc ? speaker.shortDesc[locale] : speaker.abstract[locale].split('\n')[0].replace(/^##\s+/, '').replace(/\*\*/g, '')}
                    </p>
                  </div>

                  <!-- Speakers -->
                  <div class="pt-4 border-t border-(--color-border)/50 mt-auto">
                    <div class="flex items-center gap-3">
                      <!-- Speaker Photos -->
                      <div class={`relative ${hasTwoSpeakers ? 'w-14' : 'w-10'} h-10 shrink-0`}>
                        <div class="w-10 h-10 rounded-full bg-(--color-surface) border-2 border-(--color-bg) flex items-center justify-center text-(--color-text-secondary) font-bold text-xs overflow-hidden absolute left-0 top-0 z-10">
                          {speaker.photos?.[0] || speaker.photo !== "/images/speakers/placeholder.svg" ? (
                            <img 
                              src={speaker.photos?.[0] || speaker.photo} 
                              alt={speakerNames[0]} 
                              width="40" 
                              height="40" 
                              loading="lazy" 
                              class="w-full h-full object-cover"
                            />
                          ) : (
                            <span>{speaker.initials.charAt(0)}{speaker.initials.charAt(1) || ''}</span>
                          )}
                        </div>
                        {hasTwoSpeakers && (
                          <div class="w-10 h-10 rounded-full bg-(--color-primary)/20 border-2 border-(--color-bg) flex items-center justify-center text-(--color-primary) font-bold text-xs overflow-hidden absolute left-4 top-0">
                            {speaker.photos?.[1] ? (
                              <img 
                                src={speaker.photos[1]} 
                                alt={speakerNames[1]} 
                                width="40" 
                                height="40" 
                                loading="lazy" 
                                class="w-full h-full object-cover"
                              />
                            ) : (
                              <span>{speakerNames[1].split(' ').map(n => n[0]).join('')}</span>
                            )}
                          </div>
                        )}
                      </div>
                      
                      <!-- Speaker Info -->
                      <div class="flex-1 min-w-0">
                        <p class="font-medium text-sm truncate">{speaker.name}</p>
                        <p class="text-xs text-(--color-text-secondary) truncate">
                          {speaker.role ? speaker.role[locale] : speaker.company}
                        </p>
                      </div>
                    </div>
                  </div>
                </button>
              );
            })
          }
        </div>

        <!-- Call to Action -->
        <div class="text-center mt-12 animate-on-scroll">
          <p class="text-(--color-text-secondary) mb-4">{t.schedule.register}</p>
          <a href="#registration" class="text-(--color-primary) font-semibold hover:underline inline-flex items-center gap-1">
            {t.schedule.registerLink}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </>
    )}
  </div>
</section>

<!-- Talk Modals (for scheduled view) -->
{
  isScheduled && regularTalks.map((talk) => (
    <TalkModal
      talk={talk}
      speaker={getSpeaker(talk.speakerId)}
      locale={locale}
    />
  ))
}

<!-- Speaker Modals (for unscheduled view) -->
{
  !isScheduled && speakers.map((speaker) => {
    const speakerNames = speaker.name.split(" & ");
    const hasTwoSpeakers = speakerNames.length === 2;
    
    return (
      <dialog
        id={`dialog-speaker-${speaker.id}`}
        class="speaker-modal backdrop:bg-black/80 bg-transparent p-4 max-w-2xl w-full"
      >
        <div class="glass rounded-2xl p-6 relative">
          <button
            type="button"
            class="absolute top-4 right-4 p-2 rounded-lg hover:bg-(--color-surface) transition-colors"
            data-close-modal
            aria-label={locale === "en" ? "Close" : "Zavřít"}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>

          <!-- Session Title -->
          <h3 class="font-bold text-xl mb-3 pr-10">{speaker.topic[locale]}</h3>

          <!-- Hashtags -->
          {speaker.hashtags && speaker.hashtags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {speaker.hashtags.map((tag: string) => (
                <span class="px-2 py-0.5 rounded-md bg-(--color-primary)/10 text-(--color-primary) text-xs font-medium font-mono">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          <!-- Full Abstract -->
          <div class="mb-6">
            <p class="text-xs uppercase tracking-wider text-(--color-text-secondary) font-bold mb-3">
              {t.schedule.abstract}
            </p>
            <div class="prose prose-sm prose-invert max-w-none text-(--color-text-secondary) leading-snug speaker-abstract">
              <Fragment set:html={speaker.abstract[locale]
                .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener" class="text-(--color-primary) hover:underline">$1</a>')
                .replace(/\*\*([^*]+)\*\*/g, '<strong class="text-(--color-text)">$1</strong>')
                .replace(/^## (.+)$/gm, '</p><h4 class="font-bold text-(--color-text) mt-2 mb-0.5">$1</h4><p>')
                .replace(/^- (.+)$/gm, '<li class="flex items-center gap-2 pl-2"><span class="text-(--color-primary) text-xs">●</span><span>$1</span></li>')
                .replace(/\n\n/g, '</p><p class="mt-1">')
                .replace(/\n/g, '<br/>')
                .replace(/^/, '<p>')
                .replace(/$/, '</p>')
                .replace(/<p><\/p>/g, '')
                .replace(/<p>\s*<h4/g, '<h4')
                .replace(/<\/h4>\s*<\/p>/g, '</h4>')
              } />
            </div>
          </div>

          <!-- Speakers (Column Layout) -->
          <div class="pt-6 border-t border-(--color-border)/50">
            <p class="text-xs uppercase tracking-wider text-(--color-text-secondary) font-bold mb-4">
              {hasTwoSpeakers ? (locale === "en" ? "SPEAKERS" : "ŘEČNÍCI") : (locale === "en" ? "SPEAKER" : "ŘEČNÍK")}
            </p>
            <div class={`grid ${hasTwoSpeakers ? 'grid-cols-2' : 'grid-cols-1'} gap-4`}>
              {speakerNames.map((name, idx) => (
                <div class="flex items-center gap-3">
                  <div class={`w-12 h-12 rounded-full ${idx === 0 ? 'bg-(--color-surface)' : 'bg-(--color-primary)/20'} border border-(--color-border) flex items-center justify-center ${idx === 0 ? 'text-(--color-text-secondary)' : 'text-(--color-primary)'} font-bold text-sm shrink-0 overflow-hidden`}>
                    {speaker.photos?.[idx] ? (
                      <img 
                        src={speaker.photos[idx]} 
                        alt={name.trim()} 
                        width="48" 
                        height="48" 
                        loading="lazy" 
                        class="w-full h-full object-cover"
                      />
                    ) : (
                      <span>{name.trim().split(' ').map(n => n[0]).join('')}</span>
                    )}
                  </div>
                  <div>
                    <p class="font-medium text-sm">{name.trim()}</p>
                    <p class="text-xs text-(--color-text-secondary)">
                      {speaker.role ? speaker.role[locale] : speaker.company}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </dialog>
    );
  })
}

<style>
  .timeline-talk-card {
    background: var(--glass-bg);
    backdrop-filter: blur(0.75rem);
    padding: 0.75rem;
    border-radius: 0.75rem;
    border: 0.0625rem solid var(--glass-border);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    overflow: hidden;
  }

  .timeline-talk-card:hover {
    scale: 1.02;
    box-shadow: 0 0.5rem 1.5rem -0.25rem oklch(0 0 0 / 0.15);
    border-color: var(--color-primary);
  }

  .speaker-card {
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .speaker-card:hover {
    scale: 1.02;
    box-shadow: 0 0.5rem 1.5rem -0.25rem oklch(0 0 0 / 0.15);
  }

  .speaker-modal {
    max-height: 90vh;
    overflow-y: auto;
  }

  .speaker-modal::backdrop {
    background: oklch(0 0 0 / 0.8);
  }

  .speaker-abstract strong {
    color: var(--color-text);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import { isConferenceDay } from "@utils/time";

  // Modal handling
  const dialogs = document.querySelectorAll("dialog");
  const modalTriggers = document.querySelectorAll("[data-modal-trigger]");
  const closeButtons = document.querySelectorAll("[data-close-modal]");

  // Open modal
  modalTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const talkId = trigger.getAttribute("data-modal-trigger");
      const dialog = document.getElementById(
        `dialog-${talkId}`
      ) as HTMLDialogElement;
      if (dialog) {
        dialog.showModal();
        document.body.style.overflow = "hidden";
      }
    });
  });

  // Close modal via button
  closeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const dialog = button.closest("dialog") as HTMLDialogElement;
      if (dialog) {
        dialog.close();
        document.body.style.overflow = "";
      }
    });
  });

  // Close modal when clicking backdrop
  dialogs.forEach((dialog) => {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) {
        (dialog as HTMLDialogElement).close();
        document.body.style.overflow = "";
      }
    });

    // Handle Escape key
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });
  });

  // Current time indicator
  const conferenceDate = "2026-05-29";
  const TIMELINE_START = "08:30";
  const TIMELINE_END = "18:00";

  function parseTime(time: string): number {
    const [hours, minutes] = time.split(":").map(Number);
    return hours * 60 + minutes;
  }

  function updateTimeIndicator() {
    const indicator = document.getElementById("current-time-indicator");
    if (!indicator) return;

    if (!isConferenceDay(conferenceDate)) {
      indicator.classList.add("hidden");
      return;
    }

    const now = new Date();
    const currentMinutes = now.getHours() * 60 + now.getMinutes();
    const startMinutes = parseTime(TIMELINE_START);
    const endMinutes = parseTime(TIMELINE_END);
    const totalMinutes = endMinutes - startMinutes;

    if (currentMinutes < startMinutes || currentMinutes > endMinutes) {
      indicator.classList.add("hidden");
      return;
    }

    const position = ((currentMinutes - startMinutes) / totalMinutes) * 100;
    indicator.classList.remove("hidden");
    indicator.style.top = `${position}%`;
  }

  // Update every minute
  updateTimeIndicator();
  setInterval(updateTimeIndicator, 60000);

  // For demo purposes: show indicator at a fixed position
  // Remove this in production
  const demoMode = true;
  if (demoMode) {
    const indicator = document.getElementById("current-time-indicator");
    if (indicator) {
      indicator.classList.remove("hidden");
      // Position at 11:00 (approximately 25% through the day for visual demo)
      indicator.style.top = "26%";
    }
  }
</script>
