---
import type { Locale, Talk, Speaker, Track } from "@utils/types";
import TalkCard from "./TalkCard.astro";
import SessionTile from "./schedule/SessionTile.astro";
import SessionDetail from "./schedule/SessionDetail.astro";
import SpeakerCard from "./schedule/SpeakerCard.astro";
import scheduleData from "@data/schedule.json";
import speakersData from "@data/speakers.json";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

const speakerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/speakers/*.{jpeg,jpg,png,gif,avif,svg}",
  { eager: true }
);

const getSpeakerImage = (imagePath: string | undefined) => {
  if (!imagePath) return undefined;
  const imageName = imagePath.split("/").pop();
  const fullPath = `/src/assets/images/speakers/${imageName}`;
  return speakerImages[fullPath]?.default;
};

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = locale === "en" ? en : cz;

const { conference, isScheduled } = scheduleData;
const tracks = scheduleData.tracks as Track[];
const schedule = scheduleData.schedule as Talk[];
const speakers = speakersData.speakers as Speaker[];

const titleWords = t.schedule.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");

// Timeline configuration
const TIMELINE_START = "08:00";
const TIMELINE_END = "17:00";
const SLOT_MINUTES = 15;

const parseTime = (time: string): number => {
  const [hours, minutes] = time.split(":").map(Number);
  return hours * 60 + minutes;
};

// Calculate time slots for the timeline
const startMinutes = parseTime(TIMELINE_START);
const endMinutes = parseTime(TIMELINE_END);
const totalMinutes = endMinutes - startMinutes;
const totalSlots = Math.ceil(totalMinutes / SLOT_MINUTES);

const generateTimeLabels = (): string[] => {
  const labels: string[] = [];
  for (let i = 0; i <= totalSlots; i++) {
    const mins = startMinutes + i * SLOT_MINUTES;
    const hours = Math.floor(mins / 60);
    const minutes = mins % 60;
    labels.push(
      `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}`
    );
  }
  return labels;
};

const timeLabels = generateTimeLabels();

const getSpeaker = (speakerId?: string): Speaker | undefined => {
  if (!speakerId) return undefined;
  return speakers.find((s) => s.id === speakerId);
};

const getTalkPosition = (talk: Talk): { top: number; height: number } => {
  const talkStart = parseTime(talk.startTime);
  const talkEnd = parseTime(talk.endTime);
  const top = ((talkStart - startMinutes) / totalMinutes) * 100;
  const height = ((talkEnd - talkStart) / totalMinutes) * 100;
  return { top, height };
};

const getTrackTalks = (trackId: string): Talk[] => {
  return schedule.filter((item) => item.track === trackId);
};

// Get shared items (breaks and specials that span both tracks)
const sharedItems = schedule.filter((item) => item.track === "both");
const trackATalks = getTrackTalks("track-a");
const trackBTalks = getTrackTalks("track-b");

// Get talks with speaker details for the shared modal
const detailedTalks = schedule.filter((item) => item.speakerId);

// Calculate the pixel height for the timeline (for scrollable container)
const PIXELS_PER_SLOT = 80;
const timelineHeight = totalSlots * PIXELS_PER_SLOT;
---

<section
  id="schedule"
  class="bg-(--color-surface)"
  aria-labelledby="schedule-title"
>
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="schedule-title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        {restTitle && <span class="text-gradient text-glow">{restTitle}</span>}
      </h2>
      {
        isScheduled ? (
          <p class="text-lg text-(--color-text-secondary) animate-on-scroll-delayed font-mono">
            <time datetime={conference.date}>{conference.date}</time> |
            <time datetime={`2026-05-28T${TIMELINE_START}`}>
              {TIMELINE_START}
            </time>{" "}
            -<time datetime={`2026-05-28T${TIMELINE_END}`}>{TIMELINE_END}</time>
          </p>
        ) : (
          <p class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto animate-on-scroll-delayed">
            {t.schedule.subtitle}
          </p>
        )
      }
    </div>

    {isScheduled ? (
      <>
        <!-- Desktop Timeline View -->
        <div class="hidden lg:block">
          <!-- Track Headers -->
          <div
            class="track-header-sticky grid grid-cols-[5rem_1fr_1fr] gap-4 mb-4 sticky top-(--header-height) z-40 bg-(--color-surface) py-4 transition-all duration-300"
          >
            <div class="flex items-center justify-center">
              <span
                class="text-sm font-semibold font-mono text-(--color-text-secondary) uppercase tracking-wider"
              >
                {locale === "en" ? "Time" : "Čas"}
              </span>
            </div>
            {
              tracks.map((track, index) => (
                <div
                  class="track-header-card rounded-xl p-4 text-center animate-scale-up bg-(--color-bg) border border-(--color-border) transition-all duration-300 origin-top"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <h3 class="font-bold text-(--color-text) transition-colors duration-300">
                    {track.name[locale]}
                  </h3>
                </div>
              ))
            }
          </div>

          <!-- Timeline Container -->
          <div
            class="relative overflow-x-visible"
            style={`height: ${timelineHeight}px`}
          >
            <!-- Current Time Indicator -->
            <div
              id="current-time-indicator"
              class="current-time-indicator hidden"
              style="z-index: 30;"
            >
            </div>

            <!-- Time Grid -->
            <div class="absolute inset-0 grid grid-cols-[5rem_1fr_1fr] gap-4">
              <!-- Time Labels Column -->
              <div class="relative">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 flex items-center justify-end pr-3 font-mono ${isHour ? "font-semibold text-(--color-text)" : "text-xs text-(--color-text-secondary)"}`}
                        style={`top: ${top}%; transform: translateY(-50%);`}
                      >
                        <time datetime={`2026-05-28T${time}`}>{time}</time>
                      </div>
                    );
                  })
                }
              </div>

              <!-- Track A Column -->
              <div class="relative border-l border-(--color-border)">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 border-t ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                        style={`top: ${top}%;`}
                      />
                    );
                  })
                }
                {
                  sharedItems.map((item) => {
                    const pos = getTalkPosition(item);
                    const isBreak = item.type === "break";
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <div
                          class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-primary/5 border border-dashed border-primary/20" : "glass"}`}
                        >
                          <div class="text-center px-6">
                            <p
                              class={`text-base sm:text-lg font-semibold ${isBreak ? "text-primary" : "text-(--color-text)"}`}
                            >
                              {item.title[locale]}
                            </p>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
                {
                  trackATalks.map((talk) => {
                    const pos = getTalkPosition(talk);
                    const speaker = getSpeaker(talk.speakerId);
                    const photoPaths = speaker?.photos?.length
                      ? speaker.photos
                      : speaker?.photo
                        ? [speaker.photo]
                        : [];
                    const speakerImages = photoPaths.map((path) => getSpeakerImage(path));
                    const company = talk.company || speaker?.company;
                    const country = talk.country || speaker?.country;
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <SessionTile
                          talk={talk}
                          speaker={speaker}
                          speakerImages={speakerImages}
                          locale={locale}
                          viewDetailsLabel={t.schedule.viewDetails}
                          company={company}
                          country={country}
                        />
                      </div>
                    );
                  })
                }
              </div>

              <!-- Track B Column -->
              <div class="relative border-l border-(--color-border)">
                {
                  timeLabels.map((time, index) => {
                    const isHour = time.endsWith(":00");
                    const top = (index / totalSlots) * 100;
                    return (
                      <div
                        class={`absolute left-0 right-0 border-t ${isHour ? "border-(--color-border)" : "border-(--color-border)/30"}`}
                        style={`top: ${top}%;`}
                      />
                    );
                  })
                }
                {
                  sharedItems.map((item) => {
                    const pos = getTalkPosition(item);
                    const isBreak = item.type === "break";
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <div
                          class={`h-full flex items-center justify-center rounded-lg ${item.type === "break" ? "bg-primary/5 border border-dashed border-primary/20" : "glass"}`}
                        >
                          <div class="text-center px-6">
                            <p
                              class={`text-base sm:text-lg font-semibold ${isBreak ? "text-primary" : "text-(--color-text)"}`}
                            >
                              {item.title[locale]}
                            </p>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
                {
                  trackBTalks.map((talk) => {
                    const pos = getTalkPosition(talk);
                    const speaker = getSpeaker(talk.speakerId);
                    const photoPaths = speaker?.photos?.length
                      ? speaker.photos
                      : speaker?.photo
                        ? [speaker.photo]
                        : [];
                    const speakerImages = photoPaths.map((path) => getSpeakerImage(path));
                    const company = talk.company || speaker?.company;
                    const country = talk.country || speaker?.country;
                    return (
                      <div
                        class="absolute left-0 right-0 px-2 py-1"
                        style={`top: ${pos.top}%; height: ${pos.height}%;`}
                      >
                        <SessionTile
                          talk={talk}
                          speaker={speaker}
                          speakerImages={speakerImages}
                          locale={locale}
                          viewDetailsLabel={t.schedule.viewDetails}
                          company={company}
                          country={country}
                        />
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile View (Card List) -->
        <div class="lg:hidden space-y-3 overflow-hidden">
          {
            schedule.map((talk, index) => {
              const speaker = getSpeaker(talk.speakerId);
              const photoPaths = speaker?.photos?.length
                ? speaker.photos
                : speaker?.photo
                  ? [speaker.photo]
                  : [];
              const speakerImages = photoPaths.map((path) => getSpeakerImage(path));

              return (
                <div>
                  {talk.track !== "both" && (
                    <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-2">
                      {talk.track === "track-a"
                        ? tracks[0].name[locale]
                        : tracks[1].name[locale]}
                    </div>
                  )}
                  <TalkCard
                    talk={talk}
                    speaker={speaker}
                    speakerImages={speakerImages}
                    locale={locale}
                    delay={index * 30}
                  />
                </div>
              );
            })
          }
        </div>
      </>
    ) : (
      <>
        <!-- Speakers Grid (Unscheduled View) -->
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {
            speakers.map((speaker, index) => {
              const photo1 = speaker.photos?.[0] || speaker.photo;
              const photo2 = speaker.photos?.[1];
              const img1 = getSpeakerImage(photo1);
              const img2 = getSpeakerImage(photo2);
              const talk = schedule.find((t) => t.speakerId === speaker.id);
              const company = talk?.company || speaker.company;
              const country = talk?.country || speaker.country;
              
              return (
                <SpeakerCard
                  speaker={speaker}
                  talk={talk}
                  locale={locale}
                  delay={index * 100}
                  speakerImagePrimary={img1}
                  speakerImageSecondary={img2}
                  company={company}
                  country={country}
                  viewDetailsLabel={t.schedule.viewDetails}
                />
              );
            })
          }
        </div>

        <!-- Call to Action -->
        <div class="text-center mt-12 animate-on-scroll">
          <p class="text-(--color-text-secondary) mb-4">{t.schedule.register}</p>
          <a href="#registration" class="text-primary font-semibold hover:underline inline-flex items-center gap-1">
            {t.schedule.registerLink}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </>
    )}
  </div>
</section>

<!-- Shared Session Modals -->
{
  detailedTalks.map((talk) => {
    const speaker = getSpeaker(talk.speakerId);
    const photoPaths = speaker?.photos?.length
      ? speaker.photos
      : speaker?.photo
        ? [speaker.photo]
        : [];
    const speakerImages = photoPaths.map((path) => getSpeakerImage(path));

    return (
      <SessionDetail
        talk={talk}
        speaker={speaker}
        speakerImages={speakerImages}
        locale={locale}
        isScheduled={isScheduled}
      />
    );
  })
}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  function initSchedule() {
    // Modal handling
    const dialogs = document.querySelectorAll("dialog");
    const modalTriggers = document.querySelectorAll("[data-modal-trigger]");
    const closeButtons = document.querySelectorAll("[data-close-modal]");

    // Open modal
    modalTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const talkId = trigger.getAttribute("data-modal-trigger");
        const dialog = document.getElementById(
          `dialog-${talkId}`
        ) as HTMLDialogElement;
        if (dialog) {
          dialog.showModal();
          document.body.style.overflow = "hidden";
        }
      });
    });

    // Close modal via button
    closeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const dialog = button.closest("dialog") as HTMLDialogElement;
        if (dialog) {
          dialog.close();
          document.body.style.overflow = "";
        }
      });
    });

    // Close modal when clicking backdrop
    dialogs.forEach((dialog) => {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          (dialog as HTMLDialogElement).close();
          document.body.style.overflow = "";
        }
      });

      // Handle Escape key
      dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
      });
    });

    // Current time indicator
    const conferenceDate = "2026-05-28";
    const TIMELINE_START = "08:00";
    const TIMELINE_END = "17:00";

    function parseTime(time: string): number {
      const [hours, minutes] = time.split(":").map(Number);
      return hours * 60 + minutes;
    }

    function updateTimeIndicator() {
      const indicator = document.getElementById("current-time-indicator");
      if (!indicator) return;

      const today = new Date();
      const eventDate = new Date(`${conferenceDate}T00:00:00`);
      const todayStart = new Date(
        today.getFullYear(),
        today.getMonth(),
        today.getDate()
      );

      if (todayStart.getTime() > eventDate.getTime()) {
        indicator.classList.add("hidden");
        return;
      }

      const currentMinutes = today.getHours() * 60 + today.getMinutes();
      const startMinutes = parseTime(TIMELINE_START);
      const endMinutes = parseTime(TIMELINE_END);
      const totalMinutes = endMinutes - startMinutes;

      if (currentMinutes < startMinutes || currentMinutes > endMinutes) {
        indicator.classList.add("hidden");
        return;
      }

      const position = ((currentMinutes - startMinutes) / totalMinutes) * 100;
      indicator.classList.remove("hidden");
      indicator.style.top = `${position}%`;
    }

    // Update every minute
    updateTimeIndicator();
    // Clear existing interval if any (not easily possible without storing it, but page-load usually means new context if not careful)
    // Ideally we store interval ID on window or element to clear it.
    // However, in Astro View Transitions, scripts re-run.
    // Let's rely on component cleanup or just set it.
    const intervalId = setInterval(updateTimeIndicator, 60000);
    
    // Cleanup interval on page unload (astro:before-swap)
    document.addEventListener("astro:before-swap", () => {
      clearInterval(intervalId);
    }, { once: true });

  }

  document.addEventListener("astro:page-load", initSchedule);
  initSchedule();
</script>
