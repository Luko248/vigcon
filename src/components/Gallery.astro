---
import { Image } from "astro:assets";
import type { Locale } from '@utils/types';
import en from '@i18n/en.json';
import cz from '@i18n/cz.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale === 'en' ? en : cz;

// Load images dynamically
const galleryAssets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/gallery/*.{jpeg,jpg,png,gif,avif}",
  { eager: true }
);

const getGalleryImage = (filename: string) => {
  const fullPath = `/src/assets/images/gallery/${filename}`;
  return galleryAssets[fullPath]?.default;
};

// Gallery configuration (mapped to translations)
const galleryConfig = [
  { filename: 'IMG_0050.avif', alt: t.gallery.images.img_0050 },
  { filename: 'IMG_0052.avif', alt: t.gallery.images.img_0052 },
  { filename: 'IMG_0091.avif', alt: t.gallery.images.img_0091 },
  { filename: 'IMG_3820.avif', alt: t.gallery.images.img_3820 },
  { filename: 'IMG_7715.avif', alt: t.gallery.images.img_7715 },
  { filename: 'IMG_7722.avif', alt: t.gallery.images.img_7722 },
  { filename: 'IMG_7735.avif', alt: t.gallery.images.img_7735 },
  { filename: 'IMG_7772.avif', alt: t.gallery.images.img_7772 },
  { filename: 'IMG_7815.avif', alt: t.gallery.images.img_7815 },
  { filename: 'IMG_7740.avif', alt: t.gallery.images.img_7740 }
];

const galleryImages = galleryConfig.map(item => {
  const image = getGalleryImage(item.filename);
  if (!image) throw new Error(`Image not found: ${item.filename}`);
  return {
    ...item,
    image,
    // Keep aspect ratio for masonry layout calculation if needed
    aspectRatio: `${image.width} / ${image.height}`
  };
});

const titleWords = t.gallery.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");
---

<section
  id="gallery"
  class="bg-(--color-surface)"
  aria-labelledby="gallery-title"
>
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="gallery-title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        <span class="text-gradient text-glow">{restTitle}</span>
      </h2>
      <p class="text-lg text-(--color-text-secondary) animate-on-scroll-delayed">
        {t.gallery.subtitle}
      </p>
    </div>

    <!-- Gallery Grid -->
    <div
      class="columns-2 md:columns-3 gap-4 space-y-4"
      role="list"
      aria-label={t.gallery.title}
    >
      {galleryImages.map((item, index) => (
        <a
          href={item.image.src}
          data-fancybox="gallery"
          data-caption={item.alt}
          class="group relative block w-full rounded-xl overflow-hidden animate-scale-up break-inside-avoid"
          style={`animation-delay: ${index * 50}ms; aspect-ratio: ${item.aspectRatio}`}
          aria-label={item.alt}
        >
          <!-- Placeholder for missing images -->
          <div class="absolute inset-0 bg-linear-to-br from-primary/20 to-primary/5 flex items-center justify-center opacity-0 transition-opacity duration-300 pointer-events-none group-hover:opacity-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary/30" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
          </div>

          <!-- Actual image -->
          <Image
            src={item.image}
            alt={item.alt}
            class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-110"
            style={`aspect-ratio: ${item.aspectRatio}`}
          />

          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/20 transition-colors duration-300 flex items-center justify-center pointer-events-none">
            <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white drop-shadow-lg" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
                <path d="M11 8v6"/>
                <path d="M8 11h6"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Fancybox Initialization -->
<script>
  // Define type for Fancybox class
  type FancyboxType = {
    bind: (selector: string, options: any) => void;
    unbind: (selector: string) => void;
    close: () => void;
  };

  // Store instance at module level to persist across View Transitions
  let FancyboxInstance: FancyboxType | null = null;

  const bindFancybox = () => {
    if (!FancyboxInstance) return;
    
    // Unbind first to prevent duplicates (though Fancybox usually handles this)
    FancyboxInstance.unbind('[data-fancybox="gallery"]');
    
    FancyboxInstance.bind('[data-fancybox="gallery"]', {
      Thumbs: {
        type: "classic",
      },
      Toolbar: {
        display: {
          left: ["infobar"],
          middle: [],
          right: ["close"],
        },
      },
      // Disable hash to prevent routing issues and "new tab" behavior on second click
      Hash: false,
      // Ensure click event is properly handled
      closeButton: "top",
      dragToClose: false,
      Carousel: {
        infinite: false,
      },
    });
  };

  const initFancybox = () => {
    const gallery = document.getElementById("gallery");
    if (!gallery) return;

    // If already loaded, just re-bind (needed for View Transitions navigation)
    if (FancyboxInstance) {
      bindFancybox();
      return;
    }

    const observer = new IntersectionObserver(
      async (entries) => {
        const entry = entries[0];
        if (entry.isIntersecting) {
          observer.disconnect();

          try {
            const module = await import("@fancyapps/ui/dist/fancybox/");
            await import("@fancyapps/ui/dist/fancybox/fancybox.css");
            
            FancyboxInstance = module.Fancybox as unknown as FancyboxType;
            bindFancybox();
          } catch (error) {
            console.error("Error loading Fancybox:", error);
          }
        }
      },
      {
        rootMargin: "200px", // Preload when getting close
      }
    );

    observer.observe(gallery);
  };

  // Run on initial load and after view transitions
  // Run on initial load and after View Transition navigation
  document.addEventListener("astro:page-load", initFancybox);

  // Also run immediately if DOM is already loaded
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFancybox);
  } else {
    initFancybox();
  }
</script>
