---
import type { Locale } from '@utils/types';
import en from '@i18n/en.json';
import cz from '@i18n/cz.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale === 'en' ? en : cz;

// Gallery images
const galleryImages = [
  {
    src: '/images/gallery/IMG_0050.avif',
    width: 1024,
    height: 683,
    alt: t.gallery.images.img_0050
  },
  {
    src: '/images/gallery/IMG_0052.avif',
    width: 1024,
    height: 683,
    alt: t.gallery.images.img_0052
  },
  {
    src: '/images/gallery/IMG_0091.avif',
    width: 1024,
    height: 683,
    alt: t.gallery.images.img_0091
  },
  {
    src: '/images/gallery/IMG_3820.avif',
    width: 1024,
    height: 768,
    alt: t.gallery.images.img_3820
  },
  {
    src: '/images/gallery/IMG_7715.avif',
    width: 1024,
    height: 1365,
    alt: t.gallery.images.img_7715
  },
  {
    src: '/images/gallery/IMG_7722.avif',
    width: 1024,
    height: 768,
    alt: t.gallery.images.img_7722
  },
  {
    src: '/images/gallery/IMG_7735.avif',
    width: 1024,
    height: 768,
    alt: t.gallery.images.img_7735
  },
  {
    src: '/images/gallery/IMG_7772.avif',
    width: 1024,
    height: 768,
    alt: t.gallery.images.img_7772
  },
  {
    src: '/images/gallery/IMG_7815.avif',
    width: 1024,
    height: 768,
    alt: t.gallery.images.img_7815
  },
  {
    src: '/images/gallery/IMG_7740.avif',
    width: 1024,
    height: 1365,
    alt: t.gallery.images.img_7740
  }
];

const titleWords = t.gallery.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");
---

<section
  id="gallery"
  class="bg-(--color-surface)"
  aria-labelledby="gallery-title"
>
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="gallery-title"
        class="text-3xl sm:text-4xl font-bold mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        <span class="text-gradient">{restTitle}</span>
      </h2>
      <p class="text-lg text-(--color-text-secondary) animate-on-scroll-delayed">
        {t.gallery.subtitle}
      </p>
    </div>

    <!-- Gallery Grid -->
    <div
      class="columns-2 md:columns-3 gap-4 space-y-4"
      role="list"
      aria-label={t.gallery.title}
    >
      {galleryImages.map((image, index) => (
        <a
          href={image.src}
          data-fancybox="gallery"
          data-caption={image.alt}
          class="group relative block w-full rounded-xl overflow-hidden animate-scale-up break-inside-avoid"
          style={`animation-delay: ${index * 50}ms; aspect-ratio: ${image.width} / ${image.height}`}
          role="listitem"
          aria-label={image.alt}
        >
          <!-- Placeholder for missing images -->
          <div class="absolute inset-0 bg-linear-to-br from-(--color-primary)/20 to-(--color-primary)/5 flex items-center justify-center opacity-0 transition-opacity duration-300 pointer-events-none group-hover:opacity-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-(--color-primary)/30" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
          </div>

          <!-- Actual image -->
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt}
            class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-110"
            loading="lazy"
            decoding="async"
            style={`aspect-ratio: ${image.width} / ${image.height}`}
          />

          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-(--color-primary)/0 group-hover:bg-(--color-primary)/20 transition-colors duration-300 flex items-center justify-center pointer-events-none">
            <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white drop-shadow-lg" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
                <path d="M11 8v6"/>
                <path d="M8 11h6"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Fancybox Initialization -->
<script>
  import { Fancybox } from '@fancyapps/ui';
  import '@fancyapps/ui/dist/fancybox/fancybox.css';

  Fancybox.bind('[data-fancybox="gallery"]', {
    Thumbs: {
      type: 'classic',
    },
    Toolbar: {
      display: {
        left: ['infobar'],
        middle: [],
        right: ['close'],
      },
    },
  });
</script>
