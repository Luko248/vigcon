---
import type { Locale } from "@utils/types";
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale === "en" ? en : cz;

const navItems = [
  { href: "#about", label: t.nav.about },
  { href: "#schedule", label: t.nav.schedule },
  { href: "#faq", label: t.nav.faq },
  { href: "#registration", label: t.nav.register },
];
---

<a href="#main-content" class="skip-link">
  {t.accessibility.skipToContent}
</a>

<header
  class="fixed top-0 left-0 right-0 z-50 glass animate-fade-in-down dark"
  style="
    color-scheme: dark;
    --color-bg: oklch(0.15 0 0);
    --color-surface: oklch(0.2 0 0);
    --color-text: oklch(0.98 0 0);
    --color-text-secondary: oklch(0.65 0 0);
    --color-border: oklch(0.25 0 0);
    --glass-bg: oklch(0.15 0 0 / 0.85);
    --glass-border: oklch(1 0 0 / 0.1);
    color: var(--color-text);
  "
>
  <nav
    class="section-container py-4! flex items-center justify-between"
    aria-label={locale === "en" ? "Main navigation" : "Hlavní navigace"}
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 mr-auto"
      aria-label="VIG IT Conference home"
    >
      <img
        src="/images/logos/logo-white-clean.svg"
        alt="VIGCON"
        width="120"
        height="40"
        class="h-5 w-auto"
      />
    </a>

    <div class="flex items-center gap-6">
      <!-- Desktop Navigation -->
      <ul class="hidden lg:flex items-center gap-6" role="list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-medium text-(--color-text-secondary) hover:text-(--color-primary) transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button
          id="add-to-calendar-btn"
          class="hidden sm:flex btn-secondary text-sm"
          aria-label={t.cta.addToCalendar}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <span class="hidden md:inline">{t.cta.addToCalendar}</span>
        </button>

        <LanguageToggle locale={locale} />
        <ThemeToggle locale={locale} />

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-(--color-text)"
          aria-label={t.accessibility.openMenu}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden absolute top-full left-0 right-0 glass border-t border-(--color-border) transition-all duration-300 origin-top opacity-0 invisible -translate-y-2"
    role="menu"
  >
    <ul class="section-container py-4! flex flex-col gap-4" role="list">
      {
        navItems.map((item) => (
          <li role="none">
            <a
              href={item.href}
              class="block py-2 text-base font-medium text-(--color-text) hover:text-(--color-primary) transition-colors"
              role="menuitem"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li role="none" class="pt-4 border-t border-(--color-border)">
        >
        <button
          id="mobile-add-to-calendar-btn"
          class="btn-primary w-full text-sm"
          aria-label={t.cta.addToCalendar}
        >
          {t.cta.addToCalendar}
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  import { downloadICS, getConferenceEvent } from "@utils/calendar";

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  function toggleMenu() {
    const isExpanded = mobileMenuBtn?.getAttribute("aria-expanded") === "true";
    mobileMenuBtn?.setAttribute("aria-expanded", String(!isExpanded));

    if (!isExpanded) {
      // Open
      mobileMenu?.classList.remove("invisible", "opacity-0", "-translate-y-2");
      mobileMenu?.classList.add("visible", "opacity-100", "translate-y-0");
    } else {
      // Close
      mobileMenu?.classList.remove("visible", "opacity-100", "translate-y-0");
      mobileMenu?.classList.add("invisible", "opacity-0", "-translate-y-2");
    }
  }

  mobileMenuBtn?.addEventListener("click", toggleMenu);

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenuBtn?.setAttribute("aria-expanded", "false");
      mobileMenu.classList.remove("visible", "opacity-100", "translate-y-0");
      mobileMenu.classList.add("invisible", "opacity-0", "-translate-y-2");
    });
  });

  // Calendar download
  const addToCalendarBtn = document.getElementById("add-to-calendar-btn");
  const mobileAddToCalendarBtn = document.getElementById(
    "mobile-add-to-calendar-btn"
  );

  const handleCalendarDownload = () => {
    downloadICS(getConferenceEvent());
  };

  addToCalendarBtn?.addEventListener("click", handleCalendarDownload);
  mobileAddToCalendarBtn?.addEventListener("click", handleCalendarDownload);
</script>
