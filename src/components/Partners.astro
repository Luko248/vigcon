---
import type { Locale } from "@utils/types";
import en from "@i18n/en.json";
import cz from "@i18n/cz.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale === "en" ? en : cz;

// Partner data (using existing logos from public/images/partners)
const partners = [
  {
    name: "AIS Servis",
    logo: "/images/partners/logo-ais-servis-white.svg",
    url: "https://www.ais-servis.cz/",
  },
  {
    name: "CPP",
    logo: "/images/partners/cpp-white.svg",
    url: "https://www.cpp.cz/",
  },
  {
    name: "Kooperativa",
    logo: "/images/partners/koop-white.svg",
    url: "https://www.koop.cz/",
  },
];

const titleWords = t.partners.title.split(" ");
const firstWord = titleWords[0];
const restTitle = titleWords.slice(1).join(" ");
---

<section id="partners" aria-labelledby="partners-title">
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        id="partners-title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 animate-on-scroll"
      >
        <span class="text-(--color-text)">{firstWord}</span>{" "}
        <span class="text-gradient text-glow">{restTitle}</span>
      </h2>
      <p
        class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto animate-on-scroll-delayed"
      >
        {t.partners.subtitle}
      </p>
    </div>

    <!-- Partners Grid -->
    <div
      class="flex flex-wrap justify-center gap-6 md:gap-8"
      role="list"
      aria-label={t.partners.title}
    >
      {
        partners.map((partner, index) => (
          <a
            href={partner.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative glass rounded-xl p-6 sm:p-8 flex items-center justify-center w-full sm:w-[calc(50%-1rem)] md:w-[calc(33.33%-1rem)] lg:w-[calc(25%-1rem)] h-32 sm:h-auto sm:aspect-3/2 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-primary/10 animate-scale-up overflow-hidden"
            style={`animation-delay: ${index * 100}ms`}
            role="listitem"
            aria-label={`${partner.name} - Show more`}
          >
            <!-- Logo -->
            <img
              src={partner.logo}
              alt={
                locale === "en"
                  ? `${partner.name} logo, conference partner`
                  : `Logo ${partner.name}, partner konference`
              }
              class="max-w-full max-h-12 md:max-h-16 w-auto object-contain opacity-70 group-hover:opacity-100 transition-all duration-300 brightness-0 dark:brightness-100"
              loading="lazy"
              decoding="async"
            />

            <!-- Show More Overlay -->
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="px-4 py-2 rounded-full bg-(--color-surface)/80 backdrop-blur-md border border-(--color-border) text-(--color-text) font-medium text-sm transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 flex items-center gap-2">
                <span>Show more</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
